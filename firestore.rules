rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Tortlar (Məhsullar) - Hər kəs baxa bilər, daxil olmuş istifadəçi və admin dəyişə bilər
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Kateqoriyalar - Hər kəs baxa bilər, daxil olmuş istifadəçi və admin dəyişə bilər
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Dadlar (Flavors / Krem Seçimləri) - Hər kəs baxa bilər, daxil olmuş istifadəçi və admin dəyişə bilər
    match /flavors/{flavorId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Fərdi Sifarişlər - Müştərilər formanı doldurub göndərə bilər, adminlər oxuyub idarə edə bilər
    match /custom_orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Müştəri profilləri
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Bütün digər kolleksiyalar üçün qoruyucu və ehtiyat icazə qaydası
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

  }
}

