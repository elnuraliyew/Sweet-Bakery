rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Tortlar (Məhsullar) - Hər kəs baxa bilər, daxil olmuş istifadəçi və admin dəyişə bilər
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Kateqoriyalar - Hər kəs baxa bilər, daxil olmuş istifadəçi və admin dəyişə bilər
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Müştəri profilləri
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

  }
}
